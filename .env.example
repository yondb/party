# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: use in API routes / server actions only — do NOT expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Pusher (realtime chat + notifications)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# Mapbox GL JS
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin console (/admin): comma-separated emails and/or auth user UUIDs
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Canonical site URL (no trailing slash). Production: https://lfparty.com — used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# Resend — transactional email (e.g. application accepted). Verify lfparty.com in Resend before using noreply@.
RESEND_API_KEY=
RESEND_FROM=

# Optional — defaults to support@lfparty.com if unset. Resend example: lfparty <noreply@lfparty.com>
NEXT_PUBLIC_SUPPORT_EMAIL=

# Austin launch: SQL 20250601_austin_dog_walk.sql → npm run purge:legacy-places → npm run import:places
# Places import/seed scripts (terminal only)
# IMPORT_PLACES_INSECURE_TLS=1
# IMPORT_ONLY=cycling

# Growth loop v1 — AI share copy (optional; template fallback without key)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Playwright e2e (optional)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
